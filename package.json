{
  "name": "iobroker.frigate",
  "version": "3.1.1",
  "description": "Adapter for Frigate",
  "author": "TA2k <tombox2020@gmail.com>",
  "contributors": [
    "Bettman66",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.frigate",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "frigate",
    "ki",
    "detection"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iobroker-community-adapters/ioBroker.frigate.git"
  },
  "type": "module",
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/plugin-docker": "^1.2.1",
    "aedes": "^1.1.1",
    "axios": "^1.20.0",
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "admin/dm-widgets/",
    "build/",
    "docker-compose.yaml",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json test/utils.test.js test/main.test.js test/notifications.test.js --exit",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "lint": "eslint -c eslint.config.mjs && cd src-devices && npm run lint",
    "npm": "npm i && cd src-devices && npm i",
    "translate": "translate-adapter",
    "release": "release-script --all",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "prepublishOnly": "npm run build",
    "build": "tsc -p tsconfig.build.json && npm run devices-build",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-devices && npx -y npm-check-updates --upgrade",
    "devices-0-clean": "node tasks --devices-0-clean",
    "devices-1-npm": "node tasks --devices-1-npm",
    "devices-2-build": "node tasks --devices-2-build",
    "devices-3-copy": "node tasks --devices-3-copy",
    "devices-build": "node tasks --devices-build",
    "build-backend": "tsc -p tsconfig.build.json"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.frigate/issues"
  },
  "readmeFilename": "README.md"
}
